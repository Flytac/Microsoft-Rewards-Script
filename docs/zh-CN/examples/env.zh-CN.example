# Microsoft Rewards Script v4：账号配置中文示例
# 仅使用占位信息；首次可复制到仓库根目录 .env 后填写。
# 以 # 开头的行不生效；真实 .env、密码、TOTP 密钥、Token 不能提交 GitHub。
# 每组 ACCOUNT_N_* 的 N 为正整数，编号可跳过，按升序运行。

# 必填：账号邮箱，必须换成自己的账号
ACCOUNT_1_EMAIL=email@example.com
# 可选密码：无密码/Authenticator-only 账号可留在注释状态
#ACCOUNT_1_PASSWORD=your_password
# 可选 TOTP 共享密钥，不是当前六位验证码；保持保密
#ACCOUNT_1_TOTP_SECRET=
# 可选恢复邮箱，按账号实际配置
#ACCOUNT_1_RECOVERY_EMAIL=
# 两位国家/地区代码或 auto；auto 在成功获取资料后缓存地区
#ACCOUNT_1_GEO_LOCALE=auto
# BCP 47 语言标签，例如 en、zh-CN；不是把程序日志翻译成中文
#ACCOUNT_1_LANG_CODE=en
# 是否让相关 HTTP 请求使用账号代理；浏览器代理由 URL 单独配置
#ACCOUNT_1_PROXY_HTTP=false
# 浏览器代理协议支持 http/https/socks4/socks5；SOCKS 不支持认证
#ACCOUNT_1_PROXY_URL=
# 单独配置的代理端口；0 是未配置示例值，不是可用代理服务
#ACCOUNT_1_PROXY_PORT=0
# HTTP(S) 代理用户名和密码需成对提供
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
# 保存移动/电脑端设备指纹，配合会话复用；默认 false
#ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

# 第二个账号示例；仅为配置能力演示，使用仍需符合微软账号规则
#ACCOUNT_2_EMAIL=email_2@example.com
#ACCOUNT_2_PASSWORD=your_password
#ACCOUNT_2_TOTP_SECRET=
#ACCOUNT_2_RECOVERY_EMAIL=
#ACCOUNT_2_GEO_LOCALE=auto
#ACCOUNT_2_LANG_CODE=en
#ACCOUNT_2_PROXY_HTTP=false
#ACCOUNT_2_PROXY_URL=
#ACCOUNT_2_PROXY_PORT=0
#ACCOUNT_2_PROXY_USERNAME=
#ACCOUNT_2_PROXY_PASSWORD=

# 可选 Control API 认证令牌，与 Microsoft 令牌无关
# 仅设置 API_TOKEN 不会自动开启 Docker 的 API_MODE
# 生成随机令牌：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#API_TOKEN=

